{
  "openapi": "3.0.3",
  "info": {
    "title": "EventOre Sprint 1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "eventore_session"
      }
    },
    "schemas": {
      "Payload": {
        "type": "object",
        "required": [
          "mineralType",
          "weight",
          "weightUnit",
          "originEvidence"
        ],
        "properties": {
          "mineralType": {
            "type": "string"
          },
          "weight": {
            "type": "string",
            "example": "125.50",
            "description": "Positive decimal string"
          },
          "weightUnit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "t"
            ]
          },
          "originEvidence": {
            "type": "object",
            "required": [
              "reference",
              "source"
            ],
            "properties": {
              "reference": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "clientEventId",
          "eventType",
          "occurredAt",
          "dependencies",
          "payload"
        ],
        "properties": {
          "clientEventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "LotRegistered"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Empty for LotRegistered in Sprint 1"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          }
        }
      },
      "Outcome": {
        "type": "object",
        "properties": {
          "clientEventId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "Accepted",
              "AlreadyProcessed",
              "Conflict",
              "Rejected"
            ]
          },
          "lotId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Start 8-hour session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identity and HttpOnly session cookie"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Invalid origin"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Authenticated identity",
        "responses": {
          "200": {
            "description": "Identity: userId, tenantId, email"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Invalid origin"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke current session",
        "responses": {
          "204": {
            "description": "Session cleared"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Invalid origin"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/lots": {
      "post": {
        "summary": "Register mineral lot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Payload"
                  },
                  {
                    "type": "object",
                    "required": [
                      "clientEventId"
                    ],
                    "properties": {
                      "clientEventId": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already processed"
          },
          "201": {
            "description": "Registered lot: lotId, mineralType, weight, weightUnit, status, version, originEvidenceStatus, transportStatus, qrProvesOrigin"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Invalid origin"
          },
          "409": {
            "description": "Conflicting replay"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/lots/{lotId}": {
      "get": {
        "summary": "Read lot within own organization",
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current lot: lotId, mineralType, weight, weightUnit, status, version, originEvidenceStatus, transportStatus, qrProvesOrigin"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Invalid origin"
          },
          "404": {
            "description": "Not found in organization"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/lots/{lotId}/qr": {
      "get": {
        "summary": "QR linking to authenticated application lookup",
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "QR image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Invalid origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Cancelled lot"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/events/synchronize": {
      "post": {
        "summary": "Process events idempotently",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sourceId",
                  "events"
                ],
                "properties": {
                  "sourceId": {
                    "type": "string"
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/components/schemas/Event"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-event outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Outcome"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Invalid origin"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    }
  }
}
